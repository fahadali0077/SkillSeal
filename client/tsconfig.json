{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@SkillSeal/shared": [
        "../shared/src/index.ts"
      ]
    },
    "noImplicitAny": false,
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/tests"
  ]
}