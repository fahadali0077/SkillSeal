# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/SkillSeal?retryWrites=true&w=majority
REDIS_URL=redis://<user>:<password>@<host>:<port>

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=<64-char-random-string>
JWT_REFRESH_SECRET=<64-char-random-string>

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── Media (Cloudinary) ────────────────────────────────────────────────────────
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://123456789012345:abc123@mycloud

# ─── App ───────────────────────────────────────────────────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxx
FROM_EMAIL=noreply@yourdomain.com

# ─── Stripe (disabled — leave blank) ──────────────────────────────────────────
# Uncomment and fill when enabling billing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# STRIPE_RECRUITER_MONTHLY_PRICE_ID=price_...
# STRIPE_RECRUITER_YEARLY_PRICE_ID=price_...
