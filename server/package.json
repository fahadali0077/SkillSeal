{
  "name": "server",
  "version": "1.0.0",
  "description": "SkillSeal API server",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc --project tsconfig.json",
    "seed": "node dist/scripts/seedSkills.js",
    "build:prod": "tsc --project tsconfig.json && node dist/scripts/seedSkills.js && node -e \"require('fs').rmSync('dist/scripts',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "jest --runInBand --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "groq-sdk": "^0.9.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "socket.io": "^4.7.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "uuid": "^14.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "ts-jest": "^29.1.5"
  }
}
